<launch>
  <node pkg="p2_dduong3" type="p2b.py" name="green_ball_follower" output="screen">
    <param name="rgb_topic" value="/camera/color/image_raw"/>
    <param name="depth_topic" value="/camera/depth/image_raw"/>
    <param name="vel_topic" value="/cmd_vel_mux/input/navi"/>
  </node>
</launch>
